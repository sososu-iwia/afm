# ---- Конфигурация production. Скопируйте в .env.production и заполните. ----
# Секреты не коммитятся: .env.production в .gitignore.

# База данных
POSTGRES_DB=kendala
POSTGRES_USER=kendala
POSTGRES_PASSWORD=ЗАПОЛНИТЕ

# Ключ подписи токенов: сгенерируйте командой
#   openssl rand -base64 64
APP_JWT_SECRET=ЗАПОЛНИТЕ

# Домен, с которого открывается интерфейс
APP_CORS_ALLOWED_ORIGINS=https://kendala.example.kz

# Внутренний ключ между бэкендом и ИИ-сервисом (наружу не публикуется):
#   openssl rand -hex 32
AI_INTERNAL_API_KEY=ЗАПОЛНИТЕ
AI_ALLOWED_ORIGINS=http://backend:8080

# Настоящие SMS: значения выдаёт SMSC после заключения договора
APP_SMS_PROVIDER=smsc
SMSC_LOGIN=
SMSC_PASSWORD=
SMSC_SENDER=

# Текстовое заключение ИИ (необязательно: без ключа работает только скоринг)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Почтовые уведомления
MAIL_HOST=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@kendala.example.kz

# Хранилище документов: local (том Docker) или supabase
APP_STORAGE_PROVIDER=local

# Порт, на котором отдаётся интерфейс
FRONTEND_PORT=80

# Первый администратор системы.
# Пользователь с этим номером получает роль АДМИНИСТРАТОР при запуске бэкенда
# (создаётся, если его ещё нет). Дальше он назначает роли остальным через
# раздел «Пользователи». Вход по SMS-коду, пароль не нужен.
# После раздачи ролей строку можно очистить и перезапустить стек.
APP_BOOTSTRAP_ADMIN_PHONE=+77000000000
APP_BOOTSTRAP_ADMIN_NAME=Томирис Жусупова
