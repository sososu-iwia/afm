# Провайдер текстового заключения: gemini | openai | auto (по наличию ключа)
AI_LLM_PROVIDER=auto
# Google AI Studio
GEMINI_API_KEY=<gemini-api-key>
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_SECONDS=30
# OpenAI (альтернатива Gemini)
OPENAI_API_KEY=<openai-api-key>
AI_ALLOWED_ORIGINS=http://localhost:8080
AI_INTERNAL_API_KEY=replace-with-a-long-random-secret
AI_ENV=development
AI_PUBLIC_ENDPOINTS_ENABLED=false
AI_MAX_UPLOAD_BYTES=10485760
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=2
